<idea-plugin>
    <id>io.github.marattim.jetbrains-vacuum-plugin</id>
    <name>Vacuum OpenAPI Linter</name>
    <vendor url="https://github.com/Marat-Tim">Marat Tim</vendor>
    <description><![CDATA[
        Integration with
        <a href="https://github.com/daveshanley/vacuum">vacuum</a>
        to lint openapi files
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                instance="io.github.marattim.vacuumjetbrainsplugin.VacuumSettingsConfigurable"
                id="io.github.marattim.vacuum.settings"
                bundle="VacuumBundle"
                key="plugin.name"
                parentId="tools"
        />
    </extensions>
    <depends>org.jetbrains.plugins.terminal</depends>
    <actions resource-bundle="VacuumBundle">
        <action id="io.github.marattim.vacuumjetbrainsplugin.RunVacuumLintOnFile"
                class="io.github.marattim.vacuumjetbrainsplugin.RunVacuumLintOnFile">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
    <change-notes>
        Initial version
    </change-notes>
</idea-plugin>